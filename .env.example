POSTGRES_USER=agenda
POSTGRES_PASSWORD=agenda
POSTGRES_DB=agenda
DATABASE_URL=postgresql+psycopg://agenda:agenda@db:5432/agenda
FLASK_ENV=development
SECRET_KEY=cambia-esto-en-produccion

# Webpay Plus: sin estas variables se usa el ambiente de pruebas de Transbank.
# En producción: WEBPAY_AMBIENTE=produccion y las credenciales que entregue Transbank.
WEBPAY_AMBIENTE=integracion
# WEBPAY_CODIGO_COMERCIO=
# WEBPAY_API_KEY=

# Dirección pública de la app (Webpay devuelve al cliente acá).
URL_PUBLICA=http://localhost:5173

# Emails. Sin configurar nada van a Mailpit (http://localhost:8025) y no salen a internet.
NOMBRE_NEGOCIO=vale.hilo
# Recibe un aviso por cada reserva nueva:
EMAIL_NEGOCIO=
# En producción, los datos SMTP del servicio de correo:
# MAIL_REMITENTE=Nombre del negocio <reservas@dominio.cl>
# MAIL_SERVIDOR=
# MAIL_PUERTO=587
# MAIL_USUARIO=
# MAIL_CLAVE=
# MAIL_USAR_TLS=true
